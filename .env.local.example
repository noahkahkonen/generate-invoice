# Salesforce credentials for the /api/invoice/[id] route.
# Copy this file to .env.local and fill in real values for local dev.
# In production (Vercel), set these via Project Settings -> Environment Variables.

# Salesforce login / instance URL (no trailing slash).
# Production: https://your-domain.my.salesforce.com
# Sandbox:    https://your-domain--sandbox.sandbox.my.salesforce.com
SF_LOGIN_URL=https://your-domain.my.salesforce.com

# Connected App Consumer Key (Client ID) for OAuth 2.0 Client Credentials Flow.
SF_CLIENT_ID=

# Connected App Consumer Secret (Client Secret) for OAuth 2.0 Client Credentials Flow.
SF_CLIENT_SECRET=
